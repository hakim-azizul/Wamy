export type tUserRole = "manager" | "supervisor" | "student";
export type tUserStatus = "active" | "suspended" | "archived";

export interface IStudentProfile {
  name: string; // 1. Name
  fathersName: string; // 2. Father's Name
  passportNumber: string; // 3. Passport Number
  passportExpiryDate: Date; // 4. Passport Expiry Date
  residencePermitExpiryDate: Date; // 5. Residence Permit Expiry Date
  countryOrNationality: string; // 6. Country / Nationality
  university: string; // 7. University
  faculty: string; // 8. Faculty
  department: string; // 9. Department
  academicYear: string; // 10. Academic Year
  apartmentNumber: string; // 11. Apartment Number
  roomNumber: string; // 12. Room Number
  score: number; // 13. Review system score (starts with initial score, editable later by office)
}

export interface IUser {
  _id?: string;
  name: string; // সব রোলের জন্যই কমন ডিসপ্লে নাম
  email: string; // লগইন ইমেইল (Unique, lowercase, trim)
  password: string; // Hashed password (কখনো API response-এ পাঠানো যাবে না)
  role: tUserRole; // "manager" | "supervisor" | "student"
  status: tUserStatus; // ডিফল্ট: "active"
  phone?: string | null; // Manager / Supervisor / Student সবার জন্য ঐচ্ছিক কন্টাক্ট নম্বর
  createdBy?: string | null; // যে manager বা supervisor অ্যাকাউন্ট তৈরি করেছে তার ObjectId (প্রথম seed manager-এর ক্ষেত্রে null)
  studentProfile?: IStudentProfile | null; // শুধু role === "student" এর ক্ষেত্রেই থাকবে
  createdAt: Date;
  updatedAt: Date;
}